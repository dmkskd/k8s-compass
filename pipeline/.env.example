# K8s Compass Pipeline - Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# GitHub API token (increases rate limit from 60/hr to 5000/hr)
# Create at: https://github.com/settings/tokens
# Scopes needed: public_repo (read-only access to public repos)
GITHUB_TOKEN=

# Anthropic API key (for LLM enrichment with Claude)
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# AWS credentials (for Bedrock LLM enrichment)
# These are optional if you have AWS CLI configured (~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Ollama host (default: http://localhost:11434)
# Only needed if running Ollama on a different host
# OLLAMA_HOST=http://localhost:11434
